<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config>
        <domain>valid-domain.test-example.gov.uk</domain>
        <domain includeSubdomains="true">valid-subdomains.test-example.gov.uk</domain>
        <domain>invalid-double-dot..test-example.gov.uk</domain>
        <domain>invalid-trailing-space.test-example.gov.uk </domain>
        <domain>invalid-trailing-slash.test-example.gov.uk/</domain>
        <domain>https://invalid-scheme.test-example.gov.uk</domain>
        <domain>invalid-port.test-example.gov.uk:443</domain>
        <pin-set>
            <pin digest="SHA-256">abcd</pin>
        </pin-set>
    </domain-config>
    <domain-config>
        <domain>invalid-second-domain-config.test-example.gov.uk/</domain>
    </domain-config>
</network-security-config>
