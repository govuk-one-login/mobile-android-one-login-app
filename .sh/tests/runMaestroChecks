#!/usr/bin/env bash
# Exit immediately if a simple command exits with a non-zero status
# see also: the 'set' command within the 'Shell Builtin Commands' section of `man bash`
set -o errexit

# Builds the mocked flavour of the app and runs the Maestro flows against it.
#
# Requires a running emulator or a connected device. maestro-runner installs the app itself,
# so the only prerequisite is the device.
#
# Optionally provide the INPUT_VERSION_CODE or INPUT_VERSION_NAME environment variables for being
# able to defer them to the gradle commands.

MAESTRO_RUNNER_VERSION="1.1.31"
APK_PATH="app/build/outputs/apk/mock/debug/app-mock-debug.apk"
REPORT_DIR="app/build/reports/maestro"

# Counts only, no names, paths or machine identifiers. Off in CI regardless.
export MAESTRO_RUNNER_NO_TELEMETRY=1

if ! command -v maestro-runner > /dev/null 2>&1; then
  echo "Installing maestro-runner ${MAESTRO_RUNNER_VERSION}..."
  curl -fsSL https://open.devicelab.dev/install/maestro-runner |
    bash -s -- --version "${MAESTRO_RUNNER_VERSION}"
  PATH="${HOME}/.maestro-runner/bin:${PATH}"
  export PATH
fi

# INPUT_VERSION_CODE or INPUT_VERSION_NAME are empty
if [[ -z "${INPUT_VERSION_CODE}" || -z "${INPUT_VERSION_NAME}" ]]
then
  echo "Assembling the mocked app without environment variables (local development)..."
  ./gradlew \
    :app:assembleMockDebug \
    --stacktrace
else
  echo "Assembling the mocked app with environment variables (GitHub workflow)..."
  ./gradlew \
    :app:assembleMockDebug \
    -PversionCode="${INPUT_VERSION_CODE}" \
    -PversionName="${INPUT_VERSION_NAME}" \
    --stacktrace
fi

echo "Running Maestro flows..."
maestro-runner test \
  --app-file "${APK_PATH}" \
  --output "${REPORT_DIR}" \
  --flatten \
  maestro/flows
